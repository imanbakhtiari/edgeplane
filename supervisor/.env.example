# Generate real values with: python ../tools/dev_env.py
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cdn:REPLACE@localhost:5432/cdn
POSTGRES_PASSWORD=REPLACE
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
SUPERVISOR_PUBLIC_URL=http://localhost:8000
JOB_POLL_INTERVAL=2
AGENT_CONNECT_TIMEOUT=10
AGENT_REQUEST_TIMEOUT=120
AGENT_PACKAGE_PATH=/opt/cdn/agent
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_SERVER_ID=localhost
POWERDNS_CDN_ZONE=edge.example.net
DNS_TTL=60
# When set, generated CDN hostnames use these shared BGP anycast addresses.
# When empty, healthy POP node public addresses are published as unicast DNS.
DNS_ANYCAST_IPV4=[]
DNS_ANYCAST_IPV6=[]
HEALTH_FAILURES=3
HEALTH_SUCCESSES=5
# Internal CA and client identity are generated once and encrypted in PostgreSQL.
# Additional explicitly trusted browser origins (JSON); loopback aliases work in development.
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# Add deployed console origins explicitly, including scheme and port.
# Example: ["https://10.20.0.10","https://cdn-admin.example.com"]
SUPERVISOR_SSH_PRIVATE_KEY=/run/secrets/edgeplane_ssh_key
AGENT_POLL_INTERVAL=300
ANALYTICS_MODE=full
# Optional HTTPS receiver. Leave empty when Grafana queries each POP Prometheus directly.
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_REMOTE_WRITE_TOKEN=
# Enables BIRD installation and BGP health monitoring on newly provisioned POPs.
# No prefixes are advertised until a validated BIRD policy is configured.
BGP_ENABLED=false
MAXMIND_CITY_DB=maxmind/GeoLite2-City.mmdb
MAXMIND_COUNTRY_DB=maxmind/GeoLite2-Country.mmdb
# Extra networks allowed to call remote Agent management APIs. Provisioning also
# adds the Supervisor's observed SSH egress IP automatically. Keep this narrow;
# a Docker bridge CIDR alone will not match traffic after Internet NAT.
AGENT_MANAGEMENT_ALLOWED_CIDRS=["127.0.0.0/8","::1/128","172.24.0.0/16"]
AGENT_PROMETHEUS_PORT=9091
AGENT_VARNISH_CACHE_SIZE=1g
AGENT_PUBLIC_PORT=8080
AGENT_TLS_PORT=8443
POWERDNS_AUTH_MODE=api_key
POWERDNS_USERNAME=
POWERDNS_PASSWORD=
SUPERVISOR_SSH_KEY_GID=1000
