# Edgeplane Supervisor bootstrap configuration
# Generate development secrets with: python ../tools/dev_env.py
# Values saved in the UI/API persist in PostgreSQL and take precedence.

# --- Runtime and database ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cdn:REPLACE@localhost:5432/cdn
POSTGRES_PASSWORD=REPLACE
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
SUPERVISOR_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# --- Jobs, health, and provisioning ---
JOB_POLL_INTERVAL=2
# Coalesce bursts of vhost/user changes before one atomic VCL switch and graceful NGINX reload.
VHOST_RECONCILE_DEBOUNCE_SECONDS=2
AGENT_POLL_INTERVAL=300
AGENT_CONNECT_TIMEOUT=10
AGENT_REQUEST_TIMEOUT=120
HEALTH_FAILURES=3
HEALTH_SUCCESSES=5
AGENT_PACKAGE_PATH=/opt/cdn/agent
SUPERVISOR_SSH_PRIVATE_KEY=/run/secrets/edgeplane_ssh_key
SUPERVISOR_SSH_KEY_GID=1000
# Extra POP management sources. Provisioning also adds the Supervisor's
# observed public SSH egress address automatically.
AGENT_MANAGEMENT_ALLOWED_CIDRS=["127.0.0.0/8","::1/128","172.24.0.0/16"]

# --- POP data-plane defaults ---
AGENT_PUBLIC_PORT=8080
AGENT_TLS_PORT=443
AGENT_PROMETHEUS_PORT=9091
AGENT_VARNISH_CACHE_SIZE=1g
BGP_ENABLED=false

# --- Monitoring and GeoIP bootstrap defaults ---
# full: metrics + hourly history; metrics_only: counters without history;
# off: health checks only. Change this later in System settings.
ANALYTICS_MODE=full
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_REMOTE_WRITE_TOKEN=
MAXMIND_COUNTRY_DB=maxmind/GeoLite2-Country.mmdb
MAXMIND_CITY_DB=maxmind/GeoLite2-City.mmdb

# --- PowerDNS bootstrap ---
# Native PowerDNS uses api_key. Use basic only if an authenticating reverse
# proxy in front of PowerDNS implements HTTP Basic authentication.
POWERDNS_API_URL=
POWERDNS_AUTH_MODE=api_key
POWERDNS_API_KEY=
POWERDNS_USERNAME=
POWERDNS_PASSWORD=
POWERDNS_SERVER_ID=localhost
POWERDNS_CDN_ZONE=edge.example.net
DNS_TTL=60
# Shared BGP-announced service addresses. Empty publishes eligible POP IPs.
DNS_ANYCAST_IPV4=[]
DNS_ANYCAST_IPV6=[]

# --- ACME / certificates ---
# Test with https://acme-staging-v02.api.letsencrypt.org/directory first.
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_DNS_PROPAGATION_SECONDS=30
