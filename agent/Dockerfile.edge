FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    AGENT_MODE=container \
    ALLOW_PRIVATE_ORIGINS=true \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libnginx-mod-http-geoip2 \
    libnginx-mod-http-headers-more-filter \
    libnginx-mod-stream \
    nginx \
    prometheus \
    prometheus-nginx-exporter \
    prometheus-node-exporter \
    prometheus-varnish-exporter \
    python3 \
    python3-venv \
    varnish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/cdn/agent
COPY agent/ ./
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install .
ENV PATH=/opt/venv/bin:$PATH

EXPOSE 80 443 9090 9443
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:9443/ready")'
CMD ["python", "install/container.py"]
