vcl 4.1;
import std;
backend default { .host = "127.0.0.1"; .port = "{{ s.origin_port }}"; }
acl local { "127.0.0.1"; "::1"; }
sub vcl_recv {
    if (client.ip !~ local) { return (synth(403)); }
    if (req.method == "PURGE") { return (synth(405)); }
    if (req.method != "GET" && req.method != "HEAD") { return (pass); }
    if (req.http.Authorization || req.http.Cookie || req.http.Upgrade || req.http.Cache-Control ~ "(?i)(no-cache|no-store)" || req.http.Pragma ~ "(?i)no-cache") { return (pass); }
{% for cache_id,cache in cache_policies %}
    if (req.http.X-CDN-Policy == "{{ cache_id }}") {
{% if not cache.enabled %}        return (pass);
{% endif %}
{% for path in cache.bypass_paths %}        if (req.url ~ "^{{ path|regex }}") { return (pass); }
{% endfor %}
{% for header in cache.bypass_headers %}        if (req.http.{{ header }}) { return (pass); }
{% endfor %}
{% if not cache.query_string %}        set req.url = regsub(req.url, "\?.*$", "");
{% endif %}
{% for param in cache.ignored_query_parameters %}
        set req.url = regsuball(req.url, "([?&]){{ param|regex }}=[^&]*&?", "\1");
        set req.url = regsub(req.url, "[?&]$", "");
{% endfor %}
    }
{% endfor %}
    return (hash);
}
sub vcl_hash {
    hash_data(req.url);
    hash_data(req.http.host);
    hash_data(req.http.X-CDN-Vhost);
    hash_data(req.http.X-CDN-Policy);
    hash_data(req.http.X-Forwarded-Proto);
    return (lookup);
}
sub vcl_backend_response {
    set beresp.http.X-CDN-Host = bereq.http.host;
    set beresp.http.X-CDN-URL = bereq.url;
    set beresp.http.X-CDN-Vhost = bereq.http.X-CDN-Vhost;
    if (bereq.uncacheable || beresp.http.Set-Cookie || beresp.http.Cache-Control ~ "(?i)(private|no-store|no-cache)") {
        set beresp.uncacheable = true;
        set beresp.ttl = 0s;
        return (deliver);
    }
{% for cache_id,cache in cache_policies %}
    if (bereq.http.X-CDN-Policy == "{{ cache_id }}") {
        if ({% for code in cache.statuses %}beresp.status != {{ code }}{{ ' && ' if not loop.last else '' }}{% endfor %}) {
            set beresp.uncacheable = true; set beresp.ttl = 0s; return (deliver);
        }
        if ({{ 'true' if cache.ignore_origin_ttl else '!beresp.http.Cache-Control && !beresp.http.Expires' }}) {
            set beresp.ttl = {{ cache.default_ttl }}s;
            if (bereq.url ~ "(?i)\.({{ cache.static_extensions|join('|') }})(\?|$)") { set beresp.ttl = {{ cache.static_ttl }}s; }
        }
        if (beresp.ttl > {{ cache.max_ttl }}s) { set beresp.ttl = {{ cache.max_ttl }}s; }
        set beresp.grace = {{ cache.grace }}s;
        set beresp.keep = {{ cache.keep }}s;
    }
{% endfor %}
}
sub vcl_deliver {
    set resp.http.X-Cache = "MISS";
    if (obj.hits > 0) { set resp.http.X-Cache = "HIT"; }
    if (req.is_hitpass || req.is_hitmiss || obj.uncacheable) { set resp.http.X-Cache = "PASS"; }
    set resp.http.X-Cache-Hits = obj.hits;
    unset resp.http.X-CDN-Host;
    unset resp.http.X-CDN-URL;
    unset resp.http.X-CDN-Vhost;
}
