# Edgeplane POP Agent configuration

# --- Identity and management API ---
AGENT_MODE=container
AGENT_ID=local-edge
AGENT_NAME=local-edge
AGENT_LISTEN_HOST=0.0.0.0
AGENT_LISTEN_PORT=9443
MANAGEMENT_CA=/etc/cdn-agent/ca.pem
SERVER_CERT=/etc/cdn-agent/server.pem
SERVER_KEY=/etc/cdn-agent/server.key
MANAGEMENT_ALLOWED_CIDRS=["127.0.0.0/8","::1/128","172.24.0.0/16"]

# --- NGINX and Varnish ---
NGINX_BINARY=/usr/sbin/nginx
NGINX_CONFIG_ROOT=/etc/nginx/cdn-managed
VARNISH_BINARY=/usr/sbin/varnishd
VARNISHADM_BINARY=/usr/bin/varnishadm
VARNISH_CONFIG_ROOT=/etc/varnish/cdn-managed
PUBLIC_PORT=8080
TLS_PORT=8443
VARNISH_CACHE_SIZE=1g
ALLOW_PRIVATE_ORIGINS=false

# --- State, logs, GeoIP, and telemetry ---
STATE_ROOT=/var/lib/cdn-agent
LOG_ROOT=/var/log/nginx/cdn
RETENTION=5
MAXMIND_COUNTRY_DB=/etc/cdn-agent/GeoLite2-Country.mmdb
MAXMIND_CITY_DB=/etc/cdn-agent/GeoLite2-City.mmdb
TELEMETRY_INTERVAL=5
TELEMETRY_MAX_BYTES=16777216
POP_PROMETHEUS_PORT=9091
